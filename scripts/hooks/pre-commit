#!/bin/sh
# Fast pre-commit gate: rustfmt only (seconds, host toolchain — no docker).
# The full parity gate runs on push (see scripts/hooks/pre-push).
# Bypass for WIP commits: HARNESS_SKIP_LOCAL_CI=1 git commit ...
[ "$HARNESS_SKIP_LOCAL_CI" = "1" ] && exit 0

# rustup's default install location, prepended unconditionally: harmless
# where cargo is already on PATH, and required on hosts whose rustup
# shims live on no persistent PATH (the cargo-env wrapper machine).
PATH="${HOME:-}/.cargo/bin:${PATH}"
export PATH

if cargo fmt --all -- --check; then
    exit 0
fi
echo >&2 "pre-commit: cargo fmt --check failed."
echo >&2 "fix: cargo fmt --all   |   bypass once: HARNESS_SKIP_LOCAL_CI=1"
exit 1
