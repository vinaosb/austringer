{
  "name": "austringer-vscode",
  "displayName": "Austringer",
  "version": "0.1.0",
  "private": true,
  "description": "VS Code thin-client frontend for the austringer agent daemon.",
  "repository": {
    "type": "git",
    "url": "https://github.com/vinaosb/austringer",
    "directory": "austringer-vscode"
  },
  "type": "module",
  "main": "./out/src/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "typecheck": "tsc -p ./ --noEmit",
    "test": "node --test \"test/*.test.ts\""
  },
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "austringer.open",
        "title": "Austringer: Open Omnibar"
      },
      {
        "command": "austringer.showTranscript",
        "title": "Austringer: Show Transcript"
      },
      {
        "command": "austringer.reconnect",
        "title": "Austringer: Reconnect to Daemon"
      },
      {
        "command": "austringer.hunkAccept",
        "title": "Austringer: Accept Hunk"
      },
      {
        "command": "austringer.hunkReject",
        "title": "Austringer: Reject Hunk"
      },
      {
        "command": "austringer.permission.allowOnce",
        "title": "Austringer: Allow Once"
      },
      {
        "command": "austringer.permission.allowSession",
        "title": "Austringer: Allow for Session"
      },
      {
        "command": "austringer.permission.deny",
        "title": "Austringer: Deny"
      }
    ],
    "configuration": {
      "title": "Austringer",
      "properties": {
        "austringer.daemonBaseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8787",
          "description": "Base URL of the austringer daemon (loopback only)."
        },
        "austringer.daemonTokenFile": {
          "type": "string",
          "default": ".austringer-daemon/daemon-token",
          "description": "Workspace-relative path of the daemon auth token file (written by austringer-daemon)."
        },
        "austringer.sessionId": {
          "type": "string",
          "default": "vscode",
          "description": "URL-addressable session id this editor attaches to."
        },
        "austringer.telemetry.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Opt-in: send active file/cursor/selection/diagnostics context with prompts so 'fix this' never asks 'which file?'."
        },
        "austringer.ideBridge.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Opt-in: expose this IDE's language servers and search to the austringer over a loopback endpoint (bridge takes priority over the austringer's own servers)."
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/vscode": "^1.137.0",
    "typescript": "^5.9.3"
  }
}
