{
  "name": "harness-vscode",
  "displayName": "Harness",
  "version": "0.1.0",
  "private": true,
  "description": "VS Code thin-client frontend for the harness agent daemon.",
  "type": "module",
  "main": "./out/src/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "typecheck": "tsc -p ./ --noEmit",
    "test": "node --test \"test/*.test.ts\""
  },
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "harness.open",
        "title": "Harness: Open Omnibar"
      },
      {
        "command": "harness.reconnect",
        "title": "Harness: Reconnect to Daemon"
      },
      {
        "command": "harness.hunkAccept",
        "title": "Harness: Accept Hunk"
      },
      {
        "command": "harness.hunkReject",
        "title": "Harness: Reject Hunk"
      },
      {
        "command": "harness.permission.allowOnce",
        "title": "Harness: Allow Once"
      },
      {
        "command": "harness.permission.allowSession",
        "title": "Harness: Allow for Session"
      },
      {
        "command": "harness.permission.deny",
        "title": "Harness: Deny"
      }
    ],
    "configuration": {
      "title": "Harness",
      "properties": {
        "harness.daemonBaseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8787",
          "description": "Base URL of the harness daemon (loopback only)."
        },
        "harness.daemonTokenFile": {
          "type": "string",
          "default": ".harness-daemon/daemon-token",
          "description": "Workspace-relative path of the daemon auth token file (written by harness-daemon)."
        },
        "harness.sessionId": {
          "type": "string",
          "default": "vscode",
          "description": "URL-addressable session id this editor attaches to."
        },
        "harness.telemetry.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Opt-in: send active file/cursor/selection/diagnostics context with prompts so 'fix this' never asks 'which file?'."
        },
        "harness.ideBridge.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Opt-in: expose this IDE's language servers and search to the harness over a loopback endpoint (bridge takes priority over the harness's own servers)."
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/vscode": "^1.137.0",
    "typescript": "^5.9.3"
  }
}
